<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
        width: 1200px;
        height: 630px;
        background: linear-gradient(135deg, #0d7a72 0%, #11998e 45%, #38ef7d 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-family: 'Segoe UI', Arial, sans-serif;
        position: relative;
        overflow: hidden;
    }

    /* Decorative circles */
    .circle { position: absolute; border-radius: 50%; background: rgba(255,255,255,0.08); }
    .c1 { width: 420px; height: 420px; top: -160px; left: -110px; }
    .c2 { width: 320px; height: 320px; bottom: -130px; right: -90px; }
    .c3 { width: 170px; height: 170px; top: 50px; right: 140px; background: rgba(255,255,255,0.06); }

    .logo-pill {
        background: #fff;
        color: #14212b;
        font-weight: 800;
        font-size: 28px;
        padding: 12px 34px;
        border-radius: 999px;
        margin-bottom: 26px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        z-index: 2;
    }
    .logo-pill span { color: #11998e; }

    .tag {
        background: rgba(255,255,255,0.22);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 4px;
        padding: 8px 24px;
        border-radius: 999px;
        margin-bottom: 30px;
        text-transform: uppercase;
        z-index: 2;
    }

    h1 {
        color: #fff;
        font-size: 78px;
        font-weight: 900;
        letter-spacing: -1px;
        margin-bottom: 14px;
        text-shadow: 0 4px 16px rgba(0,0,0,0.15);
        z-index: 2;
    }

    .subtitle {
        color: rgba(255,255,255,0.95);
        font-size: 38px;
        font-weight: 600;
        margin-bottom: 54px;
        z-index: 2;
    }

    .domain {
        color: rgba(255,255,255,0.75);
        font-size: 22px;
        letter-spacing: 1px;
        z-index: 2;
    }

    .icon {
        position: absolute;
        bottom: 90px;
        right: 110px;
        font-size: 80px;
        opacity: 0.85;
        z-index: 2;
    }
</style>
</head>
<body>
    <div class="circle c1"></div>
    <div class="circle c2"></div>
    <div class="circle c3"></div>

    <div class="logo-pill">💪 Calc<span>Fitly</span></div>
    <div class="tag">Health Basics</div>
    <h1>Is BMI Accurate?</h1>
    <div class="subtitle">7 Limitations You Should Know</div>
    <div class="domain">calcfitly.com</div>
    <div class="icon">⚖️</div>
</body>
</html>